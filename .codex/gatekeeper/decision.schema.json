{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "summary",
    "authority",
    "authorityFiles",
    "responsibility",
    "capabilitySurface",
    "qualityGuarantees",
    "reviewedScope",
    "prohibitedChanges",
    "gates"
  ],
  "properties": {
    "decision": { "enum": ["PASS", "BLOCK", "OWNER_DECISION"] },
    "summary": { "type": "string", "minLength": 1 },
    "authority": { "type": "array", "items": { "type": "string" } },
    "authorityFiles": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "responsibility": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "capabilitySurface": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "qualityGuarantees": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "reviewedScope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "prohibitedChanges": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "cleanV2Migration"],
      "properties": {
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "summary", "requirementAuthority", "responsibilityOwnership", "singleResponsibility", "abstractionAndNaming", "minimality", "scopeDrift", "dependencyDirection", "replaceability"],
          "properties": {
            "decision": { "enum": ["PASS", "BLOCK", "OWNER_DECISION"] },
            "summary": { "type": "string", "minLength": 1 },
            "requirementAuthority": { "type": "string" },
            "responsibilityOwnership": { "type": "string" },
            "singleResponsibility": { "type": "string" },
            "abstractionAndNaming": { "type": "string" },
            "minimality": { "type": "string" },
            "scopeDrift": { "type": "string" },
            "dependencyDirection": { "type": "string" },
            "replaceability": { "type": "string" }
          }
        },
        "cleanV2Migration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicable", "decision", "summary", "baselineAlignment", "legacyContamination", "temporaryConstraints", "sunsetImpact"],
          "properties": {
            "applicable": { "type": "boolean" },
            "decision": { "enum": ["PASS", "BLOCK", "OWNER_DECISION", "NOT_APPLICABLE"] },
            "summary": { "type": "string", "minLength": 1 },
            "baselineAlignment": { "type": "string" },
            "legacyContamination": { "type": "string" },
            "temporaryConstraints": { "type": "string" },
            "sunsetImpact": { "type": "string" }
          }
        }
      }
    }
  }
}
