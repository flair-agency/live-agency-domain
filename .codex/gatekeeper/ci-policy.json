{
  "version": 6,
  "default": {
    "mode": "local-only"
  },
  "branches": {
    "main": {
      "mode": "enforced",
      "provider": "codex",
      "model": "gpt-6.1-sol",
      "reasoningEffort": "medium",
      "authorityManifestPath": ".codex/gatekeeper/authorities.json",
      "authorityLimits": {
        "maxManifestBytes": 16384,
        "maxMembers": 5,
        "maxFileBytes": 131072,
        "maxTotalBytes": 262144,
        "maxPromptBytes": 524288
      },
      "ownerAddition": {
        "version": 2,
        "grade": "G0",
        "authorityId": "contributor-guidance",
        "authorityPath": "docs/governance/contributing.md",
        "promptPath": ".codex/gatekeeper/owner-addition.md",
        "schemaPath": ".codex/gatekeeper/owner-addition.schema.json"
      }
    }
  }
}
